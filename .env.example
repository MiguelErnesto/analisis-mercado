# Host = nombre del servicio Compose (DNS interno). No uses localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=analisis
POSTGRES_PASSWORD=analisis

POSTGRES_DB=analisis_mercado
POSTGRES_ADMIN_DB=postgres

# Railway: no uses este archivo. En el servicio web referencia:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
