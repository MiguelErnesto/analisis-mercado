# Red Docker del contenedor Postgres existente (docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' NOMBRE)
POSTGRES_DOCKER_NETWORK=planificador-eventos_default

# Hostname = nombre del contenedor (DNS interno). No uses localhost.
POSTGRES_HOST=planificador-postgres
POSTGRES_PORT=5432
POSTGRES_USER=planificador
POSTGRES_PASSWORD=planificador

# Base propia de este proyecto (el ETL la crea si no existe)
POSTGRES_DB=analisis_mercado
POSTGRES_ADMIN_DB=planificador_eventos
